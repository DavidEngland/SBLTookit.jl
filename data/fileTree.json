{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "version": "2.0.0",
    "allowed_extensions": [
        "nc",
        "csv",
        "dat",
        "h5",
        "parquet",
        "txt"
    ],
    "datasets": {
        "cases99": {
            "base_dir": "data/cases99",
            "path_template": "{stage}",
            "file_pattern": "^cases\\.(?<year>\\d{2})(?<month>\\d{2})(?<day>\\d{2})\\.(?<ext>[a-zA-Z0-9]+)$",
            "temporal_type": "yymmdd",
            "default_year_prefix": "19"
        },
        "floss_i": {
            "base_dir": "data/floss",
            "path_template": "FLOSS_i/{sub_dir}",
            "file_pattern": "^floss\\.(?<year>\\d{2})(?<month>\\d{2})(?<day>\\d{2})\\.(?<ext>[a-zA-Z0-9]+)$",
            "temporal_type": "yymmdd",
            "default_year_prefix": "20"
        },
        "floss_ii": {
            "base_dir": "data/floss",
            "path_template": "FLOSS_ii/{sub_dir}",
            "file_pattern": "^flossii\\.(?<year>\\d{2})(?<month>\\d{2})(?<day>\\d{2})\\.(?<ext>[a-zA-Z0-9]+)$",
            "temporal_type": "yymmdd",
            "default_year_prefix": "20"
        },
        "bllast_high_freq": {
            "base_dir": "data/bllast",
            "path_template": "raw/{format}/{height}",
            "file_pattern": "^BLLAST_(?<site>[^_]+)_(?<location>[^_]+)_(?<height>\\d+m)_Y(?<year>\\d{4})D(?<doy>\\d{3})\\.(?<ext>[a-zA-Z0-9]+)$",
            "temporal_type": "julian"
        },
        "bllast_flux": {
            "base_dir": "data/bllast",
            "path_template": "Flux_Files",
            "file_pattern": "^BLLAST(?<campaign_year>\\d{4})_(?<site>[^_]+)_(?<location>[^_]+)_(?<height>\\d+m)_flux(?<averaging_mins>\\d+)mins\\.(?<ext>[a-zA-Z0-9]+)$",
            "temporal_type": "none"
        },
        "sheba": {
            "base_dir": "data/sheba",
            "path_template": "{stage}",
            "file_pattern": "^(?<dataset_name>[a-zA-Z0-9_]+)\\.(?<ext>[a-zA-Z0-9]+)$",
            "temporal_type": "none"
        }
    }
}